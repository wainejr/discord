# Copie para .env e preencha os valores.
# Todos obrigatórios — validados por pydantic-settings ao inicializar.

# ----- Discord -----
# Token do bot no Discord Developer Portal.
DISCORD_TOKEN=seu-token-do-bot-aqui

# ID do servidor (guild) — habilite o "Developer Mode" no Discord para copiar IDs.
DISCORD_GUILD_ID=000000000000000000

# Canal onde novos vídeos/lives serão anunciados (@everyone).
DISCORD_ANNOUNCE_CHANNEL_ID=000000000000000000

# Canal interno para avisos do bot (ex.: token prestes a expirar).
DISCORD_LOG_CHANNEL_ID=000000000000000000

# ----- YouTube -----
# ID do canal do YouTube a ser monitorado (começa com "UC...").
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxx

# API key pública do YouTube Data API v3 (fallback sem OAuth).
YOUTUBE_API_KEY=sua-api-key-aqui

# ----- Opcional -----
# Nível de log: DEBUG, INFO, WARNING, ERROR. Default: INFO.
# ACELERADO_LOG_LEVEL=INFO

# Discord user ID autorizado a renovar o token YouTube via /token renew-*.
# 0 (default) desabilita essas slash commands. Ative o Developer Mode no
# Discord, clique-direito no seu nome → "Copiar ID do usuário".
# DISCORD_OWNER_ID=0

# Quanto tempo (em dias) o refresh token vive antes do bot avisar pra
# renovar. Default 7 = limite atual do Google pra OAuth apps no modo
# "Testing". Apps marcados "In production" no Cloud Console ganham
# refresh tokens praticamente eternos — coloque 9999 nesse caso.
# ACELERADO_REFRESH_TOKEN_TTL_DAYS=7
